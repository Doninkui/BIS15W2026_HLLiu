life_history <- read_csv("data/mammal_lifehistories_v2.csv", na="-999") %>%
clean_names()
names(life_history)
life_history %>%
ggplot(aes(x=order))+
geom_bar()+
coord_flip()
life_history %>%
count(order,sort = T)
life_history %>%
count(order,sort = T) %>%
ggplot(aes(x=order,y=n))+
geom_col()+
coord_flip()
life_history %>%
group_by(order) %>%
summarise(mean_mass=mean(mass,na.rm=T)) %>%
arrange(desc(mean_mass)) %>%
ggplot(aes(x=order,y=mean_mass))+
geom_col()+
coord_flip()
options(scipen=999) #cancels scientific notation for the session
life_history %>%
group_by(order) %>%
summarise(mean_mass=mean(mass,na.rm=T)) %>%
arrange(desc(mean_mass)) %>%
ggplot(aes(x=order,y=mean_mass))+
geom_col()+
coord_flip()+
scale_y_log10()
life_history %>%
group_by(order) %>%
summarise(mean_mass=mean(mass,na.rm=T)) %>%
arrange(desc(mean_mass)) %>%
ggplot(aes(x=reorder(order,mean_mass),y=mean_mass))+
geom_col()+
coord_flip()+
scale_y_log10()
names(life_history)
life_history %>%
ggplot(aes(x=gestation,y=wean_mass))+
geom_point(na.rm=T)+
scale_y_log10()+
geom_smooth(method=lm,se=F)
life_history %>%
ggplot(aes(x=order,y=mass))+
geom_boxplot(na.rm=T)+
scale_y_log10()+
coord_flip()
life_history %>%
ggplot(aes(x=mass,y=litter_size))+
geom_point(na.rm=T)+
scale_x_log10()+
geom_smooth(method = lm,se=F,na.rm=T)
life_history %>%
ggplot(aes(x=mass,y=litter_size))+
geom_point(na.rm=T)+
scale_x_log10()+
geom_smooth(method = lm,se=F,na.rm=T)+
labs(title="mass vs litter_size",x="Mass/g",y="Little_size")
life_history %>%
ggplot(aes(x=mass,y=litter_size))+
geom_point(na.rm=T)+
scale_x_log10()+
geom_smooth(method = lm,se=F,na.rm=T)+
labs(title="mass vs litter_size",x="Mass/g",y="Little_size")+
theme(plot.title = element_text(size = rel(1.5),hjust = 0.5))

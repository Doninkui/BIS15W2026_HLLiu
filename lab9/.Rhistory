homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase.csv", na = c("", "NA", "\\")) %>% clean_names()
p <- homerange %>%
ggplot(aes(x=log10_mass,y=log10_hra))
p+geom_jitter(size=3)
p <- homerange %>%
ggplot(aes(x=log10_mass,y=log10_hra))
p+geom_jitter(color="darkblue")
names(homerange)
p+geom_point(aes(color=thermoregulation,size=2))
p+geom_point(aes(shape=thermoregulation,color=thermoregulation),size=2)
p+geom_point(size=3,color="black",alpha=0.6,shape=18,fill="tan1")
ggplot(df, aes(x, y)) +
geom_point(aes(shape = factor(shape)), size = 5, fill = "lightblue") +
scale_shape_manual(values = 0:24) +
theme_void() +
theme(legend.position = "none") +
geom_text(aes(label = shape), vjust = -1, size = 5)
# Plot all available point shapes
df <- data.frame(x = 1:25, y = rep(1, 25), shape = 0:24)
ggplot(df, aes(x, y)) +
geom_point(aes(shape = factor(shape)), size = 5, fill = "lightblue") +
scale_shape_manual(values = 0:24) +
theme_void() +
theme(legend.position = "none") +
geom_text(aes(label = shape), vjust = -1, size = 5)

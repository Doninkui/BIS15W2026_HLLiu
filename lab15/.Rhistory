msleep %>%
filter(vore!="NA") %>% #took out the NA
ggplot(aes(x=vore, y=sleep_total, fill=vore))+
geom_boxplot(alpha=0.75)+
labs(title="Sleep Variable By Vore Type", fill="Vore Type")

## Build a Basic Shiny App
Recall that every shiny app has a ui, server, and run function. The ui is the user interface, which is what the user sees and interacts with. The server is where the code that creates the outputs goes. The run function is where we call the ui and server to run the app.
The basic skeleton of a shiny app looks like this:
ui <- fluidPage(
)
server <- function(input, output, session) {
}
shinyApp(ui, server)
glimpse(msleep)
msleep %>%
filter(vore!="NA") %>% #took out the NA
ggplot(aes(x=vore, y=sleep_total, fill=vore))+
geom_boxplot(alpha=0.75)+
labs(title="Sleep Variable By Vore Type", fill="Vore Type")
library(tidyverse)
library(shiny)
library(shinythemes)
library(janitor)
msleep %>%
filter(vore!="NA") %>% #took out the NA
ggplot(aes(x=vore, y=sleep_total, fill=vore))+
geom_boxplot(alpha=0.75)+
labs(title="Sleep Variable By Vore Type", fill="Vore Type")
shinyApp(ui, server)
ui <- fluidPage(
selectInput("y",
"Select Sleep Variable",
choices = c("sleep_total",
"sleep_rem",
"sleep_cycle",
"awake"),
selected = "sleep_total"),
plotOutput("plot", width = "600px", height = "500px")
)
server <- function(input, output, session) {
}
shinyApp(ui, server)
library(shiny)
ui <- fluidPage(
theme=shinythemes::shinytheme("cyborg"),
selectInput("y",
"Select Sleep Variable",
choices = c("sleep_total",
"sleep_rem",
"sleep_cycle",
"awake"),
selected = "sleep_total"),
plotOutput("plot", width = "600px", height = "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
msleep %>%
filter(vore!="NA") %>%
ggplot(aes(x = vore,
y = .data[[input$y]],
fill = vore))+
geom_boxplot(alpha=0.75)+
labs(title="Sleep Variables by Vore Type",
x="Vore",
fill="Vore Type")+
theme_minimal()
})
}
shinyApp(ui, server)
library(tidyverse)
library(shiny)
library(shinydashboard)
library(janitor)
library(tidyverse)
library(shiny)
library(shinydashboard)
library(janitor)
gestation <- read_csv("data/Data_S1.csv") %>%
clean_names() %>%
rename(gestationlength=gestationength)
ui <- fluidPage(
titlePanel("Distribution of Gastation Length by Order"),
selectInput("y",
"Select the Variable",
choices=c("bodymass",
"longevity",
"gestationlength"),
selected="gestation"),
selectInput("x",
"Select Order",
choices=sort(unique(gestation$order)),
selected="Afrosoricida"),
helpText("Thodoris Danis, Antonis Rokas; The evolution of gestation length in eutherian mammals. Proc. Biol. Sci. 1 October 2024; 291 (2033): 20241412. https://doi.org/10.1098/rspb.2024.1412"),
plotOutput("plot",width="500px",height="400px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
gestation %>%
filter(input$x==.data[["order"]]) %>%
ggplot(aes(.data[[input$y]]))+
geom_density(fill="steelblue",
color="black",
alpha=0.6)+
theme_minimal()
})
}
shinyApp(ui, server)
wolves <- read_csv("data/wolves_data/wolves_dataset.csv") %>% clean_names()
names(wolves)
wolves %>%
filter(sex!="NA") %>%
ggplot(aes(x=sex, fill=sex))+
geom_bar()+
facet_wrap(~pop)
ui <- dashboardPage(
dashboardHeader(title="Distribution of wloves in different Populaion"),
dashboardSidebar(
selectInput("x",
"Select Sex",
choices=sort(unique(wolves$sex)),
selected="AK.PEN"),
selectInput("y",
"Select Pop",
choices=sort(unique(wolves$pop)),
selected="F")
),
dashboardBody(
plotOutput("plot",width="500px",height="400px")
)
)

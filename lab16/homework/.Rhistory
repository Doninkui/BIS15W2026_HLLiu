library(tidyverse)
library(janitor)
library(dplyr)
library(readr)
library(Biostrings)
options(scipen = 999)
seq_lines <- readLines("data/goi_01.txt")
query_seq <-paste(seq_lines,collapse="")
seq_query <- DNAString(query_seq)
goi_01_blastx <- read_csv("data/goi_01_blastx.csv") %>% clean_names()
glimpse(goi_01_blastx)
top10_hits <- goi_01_blastx %>%
select(representative_sequence,
cluster_ancestor,
cluster_composition,
max_score,
query_cover,
e_value,per_ident) %>%
arrange(e_value) %>%
head(10)
top10_hits
top10_hits %>% ggplot(aes(x=cluster_ancestor,y=per_ident))+
geom_col(fill="darkblue")+
labs(title = "percent identity of top 10 hits")+
theme_minimal()
goi_01_blastn <- read_csv("data/goi_01_blastn.csv") %>% clean_names()
glimpse(goi_01_blastn)
goi_01_blastn %>%
arrange(e_value) %>% head(1)

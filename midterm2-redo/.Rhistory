library(tidyverse)
library(janitor)
library(naniar)
library(ggmap)
library(lubridate)
library(shiny)
register_stadiamaps("642bab98-037e-4566-b16b-c8f0b1a62925", write = FALSE)
polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
polar <- polar_bears %>%
replace_with_na_all(condition = ~ . %in% c(".", "", "NA"))
miss_var_summary(polar)
polar_count <-  polar %>%
count(popn,sex)
polar_count %>%
group_by(sex) %>%
ggplot(aes(x=popn,y=n,fill=sex))+
geom_col(position = "dodge")+
labs(title = "population of polar bears group by sex",x="popn",y="count")
polar<- polar %>%
mutate(year=year(capture_date))
polar_count_year <- polar %>%
count(year,popn)
polar_count_year %>%
ggplot(aes(x=year,y=n,color=popn))+
geom_line()+
labs(title = "Polar bear sampling by year with population",x="year",y="number of polar bears")+
theme_minimal()
polar %>%
select(urea_nitrogen,creatinine) %>%
summarise(min_urea=min(urea_nitrogen),
median_urea=median(urea_nitrogen),
mean_urea=mean(urea_nitrogen),
max_urea=max(urea_nitrogen),
min_creatinite=min(creatinine),
median_creatinite=median(creatinine),
mean_creatinite=mean(creatinine),
max_creatinite=max(creatinine))
polar<-polar %>%
mutate(un_creat_ratio=urea_nitrogen*0.466/creatinine)
polar <- polar %>%
mutate(fasting=case_when(
un_creat_ratio<=10~"fasting",
un_creat_ratio>10~"not fasting",
TRUE~NA_character_
))
polar
fasting_count <- polar %>%
filter(fasting=="fasting") %>%
count(year,popn)
fasting_count %>%
ggplot(aes(x=year,y=n,color=popn))+
geom_line()+
geom_point()+
labs(title = "number of fasting bear by year and popn",x="year",y="number of bears")+
theme_minimal()
polar%>%
select(lat,long) %>%
summary()
lat <- c(62.46,72.70)
long <- c(-134.8,-172.2)
bbox <- make_bbox(long,lat,f=0.05)
map1 <- get_stadiamap(bbox,maptype="stamen_terrain",zoom=7)
lat <- c(62.46,72.70)
long <- c(-134.8,-172.2)
bbox <- make_bbox(long,lat,f=0.05)
#map1 <- get_stadiamap(bbox,maptype="stamen_terrain",zoom=7)
ggmap(map1) +
geom_point(data=polar,aes(long,lat),size=0.75,color="popn",alpha=0.8)+
labs(x="Longitude",y="Latitude",title="polar_bear location")
lat <- c(62.46,72.70)
long <- c(-134.8,-172.2)
bbox <- make_bbox(long,lat,f=0.05)
#map1 <- get_stadiamap(bbox,maptype="stamen_terrain",zoom=7)
#ggmap(map1) +
#geom_point(data=polar,aes(long,lat),size=0.75,color="popn",alpha=0.8)+
#labs(x="Longitude",y="Latitude",title="polar_bear location")
ui <- fluidPage(
titlePanel("Polar Bear Urea/Creatinine Ratio"),
sidebarLayout(
sidebarPanel(
selectInput(
"fill_var",
"Select fill variable:",
choices = c("sex",
"mating",
"age_Class",
"denning",
"fasting"),
selected = "sex"
)
),
mainPanel(
plotOutput("ratioPlot")
)
)
)
server <- function(input, output, session) {
output$ratioPlot <- renderPlot({
ggplot(polar,
aes(x = un_creat_ratio,
fill = .data[[input$fill_var]])) +
geom_histogram(bins = 30, alpha = 0.7) +
facet_wrap(~popn) +
labs(
x = "Urea / Creatinine Ratio",
y = "Count",
fill = input$fill_var,
title = "Distribution of Urea/Creatinine Ratio by Population"
) +
theme_minimal()
})
}
shinyApp(ui, server)

library("tidyverse")
library("tidyverse")
library("janitor")
library("palmerpenguins") #load the palmerpenguins package
penguins %>%
select(species,island,body_mass_g) %>%
arrange(body_mass_g)
penguins %>%
filter(island==c("Biscoe","Dream"))
penguins %>%
select(body_mass_g,flipper_length_mm) %>%
ggplot(mapping=aes(x=flipper_length_mm,y=body_mass_g))+
geom_point()+
geom_smooth(method="lm",se=F)
penguins %>%
distinct()
penguins %>%
distinct(species)
penguins %>%
distinct(species,island,.keep_all = T)#keep all other variables
library("tidyverse")
library("janitor")
summary(msleep)
large
large <- msleep %>%
filter(bodywt > 150) %>%
arrange(desc(bodywt))
large
small <- msleep %>%
filter(bodywt<10) %>%
arrange(desc(bodywt))
msleep %>%
filter(bodywt>150) %>%
summarize(mean_bodywt_large=mean(bodywt))
msleep %>%
filter(bodywt<10) %>%
summarise(mean_bodywt_small=mean(bodywt))
summary(small)
